{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ssrcamerafixes.fabric1211.SsrCameraFixesFabricMod"
    ]
  },
  "mixins": [
    "ssrcamerafixes.mixins.json",
    "ssrcamerafixes.fabric1211.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "forgeconfigapiport": "*",
    "shouldersurfing": "*"
  }
}
